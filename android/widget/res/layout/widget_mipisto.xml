<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de 4 botones. Solo vistas que RemoteViews permite (LinearLayout y TextView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingBottom="6dp"
        android:text="@string/widget_titulo"
        android:textColor="@color/widget_verde"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_gasto"
            style="@style/WidgetBoton"
            android:text="@string/widget_gasto" />

        <TextView
            android:id="@+id/widget_ingreso"
            style="@style/WidgetBoton"
            android:text="@string/widget_ingreso" />

        <TextView
            android:id="@+id/widget_dictar"
            style="@style/WidgetBoton"
            android:text="@string/widget_dictar" />

        <TextView
            android:id="@+id/widget_fijo"
            style="@style/WidgetBoton"
            android:text="@string/widget_fijo" />
    </LinearLayout>
</LinearLayout>
