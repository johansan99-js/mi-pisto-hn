<?xml version="1.0" encoding="utf-8"?>
<!-- 4×1 celdas; se puede agrandar. No se actualiza solo (updatePeriodMillis=0): solo son botones. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_descripcion"
    android:initialLayout="@layout/widget_mipisto"
    android:minWidth="250dp"
    android:minHeight="70dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="50dp"
    android:previewLayout="@layout/widget_mipisto"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
